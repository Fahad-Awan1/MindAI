GROQ_API_KEY=your_groq_api_key_here
# Optional: override the LLM (must be a model available to your Groq key)
GROQ_MODEL=openai/gpt-oss-120b
SECRET_KEY=your_secret_key_here
DATABASE_URL=sqlite:///./mindai.db
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_db

# Email for verification / password-reset codes (Gmail: turn on 2-Step Verification, then create an
# App password at https://myaccount.google.com/apppasswords - see docs/AUTH_SETUP.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_letter_app_password
MAIL_FROM_NAME=MindAI

# Google sign-in: the Web OAuth client ID from Google Cloud Console
GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
