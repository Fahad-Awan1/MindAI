# Used only by `npm run build:mobile` (the Android app). The web app keeps using the Vite proxy.
# Put the public HTTPS address of MindAI here - for now the Cloudflare tunnel URL (see docs/MOBILE.md),
# later your hosted address. No trailing slash.
VITE_API_URL=https://games-hudson-motors-wellington.trycloudflare.com

# Google sign-in: the Web OAuth client ID (see docs/AUTH_SETUP.md). The button stays hidden until this is set.
VITE_GOOGLE_CLIENT_ID=854022098673-msac2575rour4ab671tgi61geannpc4k.apps.googleusercontent.com
